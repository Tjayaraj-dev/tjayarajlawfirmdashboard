# Supabase (Pro tier, Singapore region recommended)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email notifications + password reset)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Vercel Cron auth (Bearer token the cron job sends to /api/cron/*)
CRON_SECRET=

# Cloudflare R2 (off-vendor backup — set before launch)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
